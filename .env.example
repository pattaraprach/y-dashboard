# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Key (for database sync operations)
# WARNING: This has admin permissions. Keep it secret!
SUPABASE_SERVICE_KEY=your-service-role-key-here

# WooCommerce API Configuration
WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxx

# ReUI MCP personal access token (https://reui.io/account/mcp)
# REUI_MCP_TOKEN=reui_pat_...
